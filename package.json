{
  "name": "cursor-tab",
  "displayName": "cursor-tab",
  "version": "0.0.1",
  "private": true,
  "description": "cursor-tab-completion",
  "categories": [
    "Other"
  ],
  "type": "module",
  "main": "./dist/extension.mjs",
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint"
  },
  "contributes": {
    "commands": [
      {
        "command": "cursor-tab.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "bun@1.3.14"
}

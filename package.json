{
  "name": "supermaven",
  "displayName": "supermaven",
  "version": "0.0.1",
  "private": true,
  "description": "supermaven-completion",
  "categories": [
    "Other"
  ],
  "publisher": "Nayanchandrakar",
  "type": "module",
  "main": "./dist/extension.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "postinstall": "bun scripts/setup-grammars.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.136.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tree-sitter-bash": "^0.25.1",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "ultracite": "7.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "contributes": {
    "keybindings": [
      {
        "command": "supermaven.acceptCompletion",
        "key": "tab",
        "when": "editorTextFocus"
      },
      {
        "command": "supermaven.rejectCompletion",
        "key": "escape",
        "when": "editorTextFocus"
      }
    ],
    "configuration": [
      {
        "title": "Supermaven",
        "properties": {
          "supermaven.openrouterApiKey": {
            "type": "string",
            "default": "",
            "description": "Openrouter Api key"
          },
          "supermaven.groqApiKey": {
            "type": "string",
            "default": "",
            "description": "Groq Api key"
          },
          "supermaven.fireworksApiKey": {
            "type": "string",
            "default": "",
            "description": "Fireworks Api key"
          },
          "supermaven.model": {
            "type": "string",
            "description": "Model to use for tab completion",
            "default": "qwen/qwen3.8-27b"
          },
          "supermaven.maxTokens": {
            "type": "number",
            "default": 500,
            "minimum": 50,
            "maximum": 5000,
            "description": "Maximum tokens to generate"
          },
          "supermaven.completionCacheMaxEntries": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 1000,
            "description": "Maximum entries in completion cache"
          },
          "supermaven.completionCacheTtlMs": {
            "type": "number",
            "default": 30000,
            "minimum": 5000,
            "maximum": 120000,
            "description": "Completion cache in TTL in seconds"
          },
          "supermaven.lspCacheMaxEntries": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 1000,
            "description": "Maximum entries in completion cache"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "supermaven.acceptCompletion",
        "title": "Accept Completion",
        "category": "Supermaven"
      },
      {
        "command": "supermaven.rejectCompletion",
        "title": "Reject Completion",
        "category": "Supermaven"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "bun@1.3.14"
}

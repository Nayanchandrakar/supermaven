{
  "name": "cursor-tab",
  "displayName": "cursor-tab",
  "version": "0.0.1",
  "private": true,
  "description": "cursor-tab-completion",
  "categories": [
    "Other"
  ],
  "type": "module",
  "main": "./dist/extension.mjs",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint"
  },
  "contributes": {
    "configuration": [
      {
        "title": "Cursor tab completion",
        "properties": {
          "cursor-tab.openrouterApiKey": {
            "type": "string",
            "default": "",
            "description": "Openrouter Api key"
          },
          "cursor-tab.model": {
            "type": "string",
            "description": "Model to use for tab completion",
            "default": "stealth/ox-alpha"
          },
          "cursor-tab.completionCacheMaxEntries": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 1000,
            "description": "Maximum entries in completion cache"
          },
          "cursor-tab.completionCacheTtlMs": {
            "type": "number",
            "default": 30000,
            "minimum": 5000,
            "maximum": 120000,
            "description": "Completion cache in TTL in seconds"
          },
          "cursor-tab.lspCacheMaxEntries": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 1000,
            "description": "Maximum entries in completion cache"
          }
        }
      }
    ],
    "commands": []
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "packageManager": "bun@1.3.14"
}

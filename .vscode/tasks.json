{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension",
      "type": "shell",
      "command": "bun run build",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Watch Extension",
      "type": "shell",
      "command": "bun run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "tsdown",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Build start",
          "endsPattern": "(Build complete|Rebuilt)"
        }
      },
      "presentation": {
        "reveal": "never"
      }
    }
  ]
}
